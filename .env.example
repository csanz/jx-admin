# Jazaix admin console. Names only; set the values in Vercel (or .env.local for a local run). Never commit values.

# Auth.js (next-auth v5): a long random secret, and the console's own public URL.
AUTH_SECRET=
AUTH_URL=https://admin.jazaix.com

# Google OAuth client. Redirect URI: https://admin.jazaix.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to use the console (case-insensitive). The users row in MongoDB must ALSO hold role "admin".
JX_DEVELOPER_EMAILS=

# The platform database (the portal's). Local: mongodb://localhost:27018/jx_portal?replicaSet=jx-db-local-rs&directConnection=true
# Production: an internet-reachable cluster with TLS + auth (MongoDB Atlas or equivalent), see README "Production MongoDB".
MONGODB_URI=
# Optional, default jx_portal.
MONGODB_DB=

# Optional, BOTH or NEITHER: the portal link for the two money actions (JBux refund, wallet hold). Without it those two
# forms are disabled; waitlist, users and the JBux report work on MongoDB alone.
JX_PORTAL_URL=
JX_ADMIN_API_TOKEN=

# Optional: the "You're in" approval email through Resend. Without the key, approving still works and no email is sent.
RESEND_API_KEY=
JX_EMAIL_FROM=
JX_EMAIL_REPLY_TO=
# Optional: the clips API (jx-replays; production https://clips-api.jazaix.com, local http://127.0.0.1:6116). Content >
# Clips reads its public GET /api/clips (no token). Without it that page says clips are not connected.
JX_CLIPS_API_URL=

# Optional: default env filter of the JBux pages (all | local | dev | staging | prod). A production build
# defaults to prod; set all when reviewing a production build against local data.
# JX_JBUX_DEFAULT_ENV=all
