# Jazaix admin console. Names only; set the values in Vercel (or .env.local for a local run). Never commit values.

# Auth.js (next-auth v5): a long random secret, and the console's own public URL.
AUTH_SECRET=
AUTH_URL=https://admin.jazaix.com

# Google OAuth client. Redirect URI: https://admin.jazaix.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to use the console (case-insensitive). The portal must ALSO hold role "admin" for the email.
JX_DEVELOPER_EMAILS=

# The portal this console drives, and the service token the portal checks on every admin call.
JX_PORTAL_URL=https://play.jazaix.com
JX_ADMIN_API_TOKEN=
